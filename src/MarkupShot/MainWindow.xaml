<Window x:Class="MarkupShot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="markup-shot"
        Height="720"
        Width="1100"
        MinHeight="520"
        MinWidth="800"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..."
                          Click="OpenMenuItem_Click"
                          InputGestureText="Ctrl+O" />
                <MenuItem Header="_Save As..."
                          Click="SaveAsMenuItem_Click"
                          InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Header="_Copy"
                          Click="CopyMenuItem_Click"
                          InputGestureText="Ctrl+C" />
                <Separator />
                <MenuItem Header="E_xit"
                          Click="ExitMenuItem_Click" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button Content="Add Rectangle" Click="AddRectangleButton_Click" />
                <Button Content="Add Ellipse" Click="AddEllipseButton_Click" />
                <Button Content="Add Line" Click="AddLineButton_Click" />
                <Separator />
                <Button Content="Delete Selected" Click="DeleteSelectedButton_Click" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusTextBlock" Text="Open or drop a PNG/JPEG image to begin." />
        </StatusBar>

        <Border Margin="8" BorderBrush="#FF3B3B3B" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="EditorCanvas"
                            Width="960"
                            Height="540"
                            Background="#FF1F1F1F"
                            MouseLeftButtonDown="EditorCanvas_MouseLeftButtonDown"
                            MouseMove="EditorCanvas_MouseMove"
                            MouseLeftButtonUp="EditorCanvas_MouseLeftButtonUp">
                        <Image x:Name="BaseImageElement"
                               Canvas.Left="0"
                               Canvas.Top="0" />
                    </Canvas>
                </Viewbox>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
